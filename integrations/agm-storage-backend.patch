+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import test from 'node:test';
+import { buildApp } from '../index.js';
+import { loadConfig } from '../config.js';
+import { openDatabase } from '../database/database.js';
+import { signToken } from '../services/crypto.js';
+import { createStorageService } from '../services/storage.cjs';
+
+test('Storage uses approved mobile sessions and role permissions, audits reads and refuses writes', async t => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), 'agm-storage-api-'));
+  const mount = path.join(root, 'disk'); await fs.mkdir(mount);
+  await fs.writeFile(path.join(mount, 'hello.txt'), 'Contenido del disco real de prueba.');
+  const web = path.join(root, 'web');await fs.mkdir(web);await fs.writeFile(path.join(web, 'index.html'), '<title>Test</title>');
+  const config = loadConfig({ NODE_ENV: 'test', DATABASE_PATH: path.join(root, 'test.sqlite'), BACKUP_PATH: path.join(root, 'backups'), STATIC_ROOT: web, STATIC_SOURCE_PATH: web, BACKUP_ENABLED: 'false', SESSION_SECRET: 'test-session-secret-that-is-long-enough', PASSWORD_PEPPER: 'test-pepper-that-is-long-enough', MOBILE_ACCESS_TOKEN_SECRET: 'test-access-secret-that-is-long-enough', MOBILE_REFRESH_TOKEN_SECRET: 'test-refresh-secret-that-is-long-enough' });
+  const storage = createStorageService({ roots: [mount], devices: async () => [{ name: 'sda', model: 'Integration disk', type: 'disk', size: 4096, children: [{ name: 'sda1', type: 'part', mountpoints: [mount], fstype: 'ext4', size: 4096 }] }] });
+  const db = openDatabase(config.databasePath); const app = await buildApp({ config, db, storage });
+  t.after(async () => { await app.close(); db.close(); await fs.rm(root, { recursive: true, force: true }); });
+  const token = (role, status = 'approved') => {
+    const user = Number(db.prepare('INSERT INTO users (email, password_hash, role) VALUES (?, ?, ?)').run(`${role}-${status}@test.invalid`, 'unused', role).lastInsertRowid);
+    const session = `${role}-${status}`;
+    db.prepare('INSERT INTO mobile_sessions (id, user_id, device_id_hash, device_name, status, ip_hash, user_agent_hash) VALUES (?, ?, ?, ?, ?, ?, ?)').run(session, user, 'testhash', 'Test phone', status, 'testhash', 'testhash');
+    return signToken({ typ: 'mobile-access', sub: user, sid: session, exp: Math.floor(Date.now() / 1000) + 600 }, config.mobileAccessTokenSecret);
+  };
+  const admin = token('admin'); const owner = token('owner'); const member = token('member'); const pending = token('admin', 'pending');
+  const get = (url, access) => app.inject({ method: 'GET', url, headers: access ? { authorization: `Bearer ${access}` } : {} });
+  const endpoint = '/api/mobile/storage/disks';
+  assert.equal((await get(endpoint)).statusCode, 401);
+  assert.equal((await get(endpoint, member)).statusCode, 403);
+  assert.equal((await get(endpoint, pending)).statusCode, 403);
+  assert.equal((await get(endpoint, owner)).statusCode, 200);
+  const response = await get(endpoint, admin); assert.equal(response.statusCode, 200);
+  const volume = response.json()[0].volumes[0].id;
+  const dir = await get(`/api/mobile/storage/directory?volume=${volume}`, admin);
+  assert.equal(dir.statusCode, 200);assert.equal(dir.json().entries[0].name, 'hello.txt');
+  const file = await get(`/api/mobile/storage/file?volume=${volume}&path=hello.txt`, admin);
+  assert.equal(file.statusCode, 200);assert.equal(file.json().content, 'Contenido del disco real de prueba.');
+  assert.equal(db.prepare("SELECT count(*) AS n FROM audit_events WHERE action = 'storage_file_read' AND result = 'success'").get().n, 1);
+  const escape = await get(`/api/mobile/storage/file?volume=${volume}&path=..%2Fsecret`, admin);assert.equal(escape.statusCode, 400);
+  const write = await app.inject({ method: 'POST', url: '/api/mobile/storage/file', headers: { authorization: `Bearer ${admin}` } });assert.equal(write.statusCode, 404);
+  db.prepare("UPDATE mobile_sessions SET status = 'revoked' WHERE id = 'admin-approved'").run();
+  assert.equal((await get(endpoint, admin)).statusCode, 403);
+});
diff --git a/server/tests/storage.test.mjs b/server/tests/storage.test.mjs
new file mode 100644
index 0000000..19574e2
--- /dev/null
+++ b/server/tests/storage.test.mjs
@@ -0,0 +1,77 @@
+import { createRequire } from "node:module";
+const require = createRequire(import.meta.url);
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const { createStorageService, storageError } = require('../services/storage.cjs');
+
+async function fixture(t) {
+  const base = await fs.mkdtemp(path.join(os.tmpdir(), 'agm-storage-'));
+  t.after(() => fs.rm(base, { recursive: true, force: true }));
+  const root = path.join(base, 'disk'); await fs.mkdir(root);
+  await fs.mkdir(path.join(root, 'docs'));
+  await fs.writeFile(path.join(root, 'docs', 'notes.txt'), 'Hola desde la RPi.');
+  await fs.writeFile(path.join(base, 'outside.txt'), 'not shared');
+  const devices = async () => [
+    { name: 'sda', type: 'disk', size: 4096, model: 'Test SSD', children: [{ name: 'sda1', type: 'part', size: 4096, fstype: 'ext4', mountpoints: [root] }] },
+    { name: 'sdb', type: 'disk', size: 8192, children: [{ name: 'sdb1', type: 'part', size: 8192, fstype: 'exfat', mountpoints: [null] }] },
+  ];
+  const service = createStorageService({ roots: [root], devices });
+  const disks = await service.disks();
+  return { base, root, service, devices, disks, volume: disks[0].volumes[0].id };
+}
+test('independent disks, actual statfs sizes and unmounted volumes', async t => {
+  const { root, disks } = await fixture(t);
+  assert.equal(disks.length, 2);
+  const stats = await fs.statfs(root);
+  assert.equal(disks[0].volumes[0].totalBytes, stats.blocks * stats.bsize);
+  assert.equal(disks[0].volumes[0].browsable, true);
+  assert.equal(disks[1].volumes[0].browsable, false);
+  assert.equal(disks[1].volumes[0].usedBytes, null);
+});
+test('listing and preview read files, no implicit access without an allowlist', async t => {
+  const { service, volume, devices } = await fixture(t);
+  const directory = await service.directory(volume);
+  assert.equal(directory.entries[0].kind, 'directory');
+  assert.equal(directory.entries[0].path, 'docs');
+  assert.equal((await service.file(volume, 'docs/notes.txt')).content, 'Hola desde la RPi.');
+  const locked = createStorageService({ devices });
+  assert.equal((await locked.disks())[0].volumes[0].browsable, false);
+  await assert.rejects(locked.directory(volume), { status: 403 });
+});
+test('reject traversal, absolute paths, symlink files and symlink parents', async t => {
+  const { root, base, service, volume } = await fixture(t);
+  for (const name of ['../outside.txt', '/etc/passwd', 'docs/../../outside.txt', 'docs/./notes.txt', 'docs\\notes.txt', 'bad\0path']) {
+    await assert.rejects(service.file(volume, name), { status: 400 });
+  }
+  await fs.symlink(path.join(base, 'outside.txt'), path.join(root, 'link'));
+  await fs.symlink(base, path.join(root, 'linked-directory'));
+  await assert.rejects(service.file(volume, 'link'));
+  await assert.rejects(service.file(volume, 'linked-directory/outside.txt'));
+  const directory = await service.directory(volume);
