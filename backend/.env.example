# The API listens on every interface so a phone on your LAN can reach it.
MONITOR_API_PORT=8787
MONITOR_SERVER_NAME=rpi-web-01
# Optional: when set, every non-health API request requires Authorization: Bearer <value>.
# Do not commit a real value. Mobile secure-token wiring is the next production step.
MONITOR_API_KEY=

# Storage: required API authentication plus an explicit list of mounted roots.
# Values are server-side only. Never put the key in EXPO_PUBLIC variables.
MONITOR_STORAGE_ROOTS=[]
# Example on the RPi: MONITOR_STORAGE_ROOTS=["/mnt/data","/mnt/backup"]
